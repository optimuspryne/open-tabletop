# ── Docker Compose ───────────────────────────────────────────────────────────
# Copy to `.env`, set the bootstrap identity, create the three files in secrets/, then start Compose.
BOOTSTRAP_ADMIN_USERNAME=admin              # created only when the users table is empty
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Docker-secrets alternative: a path to a file whose contents are the URL above.
# When set, this takes priority over DATABASE_URL, so the secret never appears in
# the environment or `docker inspect`.
# DATABASE_URL_FILE=/run/secrets/db_url

# ── Running WITHOUT Docker (npm start) ───────────────────────────────────────
# Skip the two above and point the app straight at a database instead:
DATABASE_URL=postgresql://tabletop_app:password@localhost:5432/tabletop #If using SSL, append '?sslmode=no-verify`(encrypt only) or `?sslmode=verify-full` (verified — needs the CA) to the URL

# Shared rate-limit store. Required in production; Compose supplies its internal URL.
# REDIS_URL=redis://localhost:6379
# REDIS_URL_FILE=/run/secrets/redis_url
# Explicit local-only fallback when Redis is intentionally unavailable:
# RATE_LIMIT_STORE=memory

# Number of trusted reverse-proxy hops used to resolve req.ip (default 0/direct).
# Set only to the exact number of proxies in front of the app.
# TRUST_PROXY_HOPS=1

# Optional per-process room budgets (0/unset = no additional limit).
# Conservative demo trial values below; these do NOT enable guest/demo mode.
# Includes tables, editor rooms and waiting lobbies; admins count too.
# ROOM_MAX_LIVE=5
# ROOM_MAX_CONNECTIONS=20
# ROOM_MAX_CONNECTIONS_PER_USER=2
# ROOM_MAX_PENDING_AUTH=16
# ROOM_MAX_MESSAGES_PER_SECOND=240
# See docs/DEMO_MODE_PLAN.md for scope, limitations and manual smoke tests.

# Optional: auto-apply schema migrations on startup. Point this at the OWNER role
# (DDL-capable) — NOT tabletop_app. The app applies any pending postgres/NNN_*.sql
# on boot (recording your existing schema as the baseline the first time). Omit it,
# or set AUTO_MIGRATE=false, to apply migrations by hand instead.
MIGRATE_DATABASE_URL=postgresql://tabletop:owner-password@localhost:5432/tabletop

# Optional: where uploaded image/model files live (default: ./saved-assets).
ASSETS_DIR=./saved-assets

# Login sessions expire after this many days (default 30; allowed range 1–365).
# SESSION_TTL_DAYS=30

# Optional email verification, password reset and account recovery.
# Without SMTP, saved recovery codes remain available.
# PUBLIC_ORIGIN=https://tabletop.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                  # 587/other ports require STARTTLS; 465 uses implicit TLS
# SMTP_FROM=tabletop@example.com # bare email address
# SMTP_USER=tabletop@example.com
# SMTP_PASSWORD_FILE=/etc/open-tabletop/smtp_password # bare metal: readable by the app account
# Docker: use /run/secrets/smtp_password and mount the secret via a Compose override.
# File contents: only the SMTP/app password as plain text, no quotes or NAME= prefix.
# Use your provider's SMTP hostname, port and credentials (an app password if required).
# See docs/ACCOUNT_SECURITY.md for bare-metal, Docker and SMTP provider instructions.
# SMTP_PASSWORD=                # fallback; avoid committing secrets
