# ── Docker Compose ───────────────────────────────────────────────────────────
# Copy to `.env`, set the bootstrap identity, create the three files in secrets/, then start Compose.
BOOTSTRAP_ADMIN_USERNAME=admin              # created only when the users table is empty
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Docker-secrets alternative: a path to a file whose contents are the URL above.
# When set, this takes priority over DATABASE_URL, so the secret never appears in
# the environment or `docker inspect`.
# DATABASE_URL_FILE=/run/secrets/db_url

# ── Running WITHOUT Docker (npm start) ───────────────────────────────────────
# Skip the two above and point the app straight at a database instead:
DATABASE_URL=postgresql://tabletop_app:password@localhost:5432/tabletop #If using SSL, append '?sslmode=no-verify`(encrypt only) or `?sslmode=verify-full` (verified — needs the CA) to the URL

# Optional: auto-apply schema migrations on startup. Point this at the OWNER role
# (DDL-capable) — NOT tabletop_app. The app applies any pending postgres/NNN_*.sql
# on boot (recording your existing schema as the baseline the first time). Omit it,
# or set AUTO_MIGRATE=false, to apply migrations by hand instead.
MIGRATE_DATABASE_URL=postgresql://tabletop:owner-password@localhost:5432/tabletop

# Optional: where uploaded image/model files live (default: ./saved-assets).
ASSETS_DIR=./saved-assets

# Login sessions expire after this many days (default 30; allowed range 1–365).
# SESSION_TTL_DAYS=30
