# Copy this to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real credentials.
#
# `npm start` loads this .env automatically if it's present (via Node's
# --env-file-if-exists). With no .env file, `npm start` just uses whatever
# DATABASE_URL is already set in the environment.
#
# One-time asset import (run as the OWNER role, not tabletop_app):
#   node --env-file=.env import-assets.js

# Point the app at your Postgres. Use the least-privilege CRUD role
# (tabletop_app from grants_app_role.sql), NOT the owner role you run migrations with.
DATABASE_URL=postgresql://tabletop_app:your_app_password@localhost:5432/tabletop

# Docker-secrets alternative: a path to a file whose contents are the URL above.
# When set, this takes priority over DATABASE_URL, so the secret never appears in
# the environment or `docker inspect`.
# DATABASE_URL_FILE=/run/secrets/db_url

# Optional: where uploaded image/model files live (default: ./saved-assets).
# ASSETS_DIR=./saved-assets
